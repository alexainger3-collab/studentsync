# Copy this file to .env and fill in the values marked "you supply".
# .env is gitignored — never commit real secrets.

# Local dev: leave PORT/DATABASE_URL/NODE_ENV unset entirely — sensible
# defaults kick in (port 8787, a local SQLite file, dev mode).
PORT=
NODE_ENV=

# Production (e.g. on Render): a libsql:// URL from your Turso database,
# plus its auth token. Leave both unset to use a local file instead.
DATABASE_URL=
TURSO_AUTH_TOKEN=

# Generated automatically for you — a long random string used to sign session cookies.
SESSION_SECRET=

# Stripe — test mode keys from dashboard.stripe.com (Developers > API keys).
# Price/webhook IDs come from running `node setup-stripe.mjs <webhook-url>`.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# The origin Checkout should redirect back to after payment.
CLIENT_URL=http://localhost:5173
